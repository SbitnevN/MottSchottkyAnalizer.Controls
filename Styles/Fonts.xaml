<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:Double x:Key="SmallFontSize">12</system:Double>
    <system:Double x:Key="NormalFontSize">15</system:Double>
    <system:Double x:Key="BigFontSize">20</system:Double>
    <system:Double x:Key="HugeFontSize">30</system:Double>

    <FontFamily x:Key="TitleFont">Fonts/#Montserrat</FontFamily>
    <FontFamily x:Key="TextFont">Fonts/#Rubik</FontFamily>
    <FontFamily x:Key="Icons">Fonts/#FontAwesome</FontFamily>

</ResourceDictionary>