<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MottSchottkyAnalizer.Controls.Controls.LabeledTextBox">

    <Style TargetType="{x:Type local:LabeledTextBoxView}">

        <Setter Property="Padding" Value="5,3,5,2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="LabelFontSize" Value="{DynamicResource SmallFontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource TextFont}" />
        <Setter Property="Margin" Value="0,10" />
        <Setter Property="BorderThickness" Value="2" />

        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <AdornedElementPlaceholder />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type local:LabeledTextBoxView}">

                    <Grid>

                        <!--  TextBox  -->

                        <Border
                            x:Name="border"
                            Margin="0,10,0,0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource NormalCornerRadius}">

                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="10"
                                    Direction="270"
                                    Opacity="0.3"
                                    ShadowDepth="1" />
                            </Border.Effect>

                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />

                        </Border>


                        <!--  Label  -->

                        <Border
                            Padding="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{TemplateBinding Background}">

                            <Border.Margin>
                                <Binding Path="Padding" RelativeSource="{RelativeSource TemplatedParent}">
                                    <Binding.Converter>
                                        <local:LeftPaddingToMarginConverter />
                                    </Binding.Converter>
                                </Binding>
                            </Border.Margin>

                            <TextBlock
                                FontSize="{TemplateBinding LabelFontSize}"
                                Foreground="Gray"
                                Text="{TemplateBinding Label}" />

                        </Border>

                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentHoverBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

</ResourceDictionary>